{
  "name": "skill-run-audit",
  "version": "0.1.0",
  "description": "Audit agent skill runs for plan, validation, and side-effect boundary evidence.",
  "type": "module",
  "bin": {
    "skill-run-audit": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/*.js test/*.js",
    "build": "node scripts/build-check.js",
    "smoke": "node src/cli.js fixtures/sample.jsonl --format markdown",
    "lint": "npm run check",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:check": "npm run check && npm run test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent",
    "skill",
    "audit",
    "dry-run",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/skill-run-audit.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/skill-run-audit/issues"
  },
  "homepage": "https://github.com/rogerchappel/skill-run-audit#readme",
  "files": [
    "src",
    "docs",
    "fixtures",
    "scripts",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ]
}
